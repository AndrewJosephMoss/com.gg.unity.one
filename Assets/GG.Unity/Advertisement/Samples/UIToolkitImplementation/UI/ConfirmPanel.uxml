<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="PanelSample.uss" />

    <!-- Modal Popup that closes with true (confirm) or false (cancel). -->
    <ui:VisualElement name="dialog" class="sample-card sample-dialog">
        <ui:Label name="title" class="sample-card__title" />
        <ui:Label name="body" class="sample-card__text" />
        <ui:VisualElement class="sample-row">
            <!-- Focus the safe choice first. -->
            <ui:Button name="cancel" text="Cancel" class="sample-button panel-initial-focus" />
            <ui:Button name="confirm" text="Confirm" class="sample-button sample-button--danger" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
