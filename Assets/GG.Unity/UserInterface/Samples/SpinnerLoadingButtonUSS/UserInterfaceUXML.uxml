<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:spinner="GG.Unity.UserInterface.Buttons.Spinner" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement class="menu">
        <ui:Button text="Show Interstitial Ad" name="Button-InterstitialAd" class="menu-button"/>
        <ui:Toggle label="Banner: Top Opportunity" name="Toggle-TopBanner" class="menu-toggle menu-button"/>
        <ui:Toggle label="Banner: Bottom Opportunity" name="Toggle-BottomBanner" class="menu-toggle menu-button"/>
        <ui:Toggle label="Banner: Both Opportunity" name="Toggle-BothBanner" class="menu-toggle menu-button"/>
        <spinner:SpinnerLoadingButton text="Show Reward Ad" name="Button-RewardAd" class="menu-button"/>
    </ui:VisualElement>
</ui:UXML>
