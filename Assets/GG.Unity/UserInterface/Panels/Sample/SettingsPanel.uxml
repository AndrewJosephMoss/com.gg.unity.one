<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/GG.Unity/UserInterface/Panels/Sample/SettingsPanel.uss?fileID=7433441132597879392&amp;guid=090469e8199b25d46a014a0075e1dc92&amp;type=3#SettingsPanel"/>
    <Style src="project://database/Assets/UI%20Toolkit/DefaultUSS.uss?fileID=7433441132597879392&amp;guid=fe3403fa6b72ed845a025aec2abb12bf&amp;type=3#DefaultUSS"/>
    <ui:VisualElement class="popup" style="width: 80%; align-self: center; justify-content: center; align-items: center;">
        <ui:Label text="Settings" class="popup__title" style="width: 80%; font-size: 48px;"/>
        <ui:Slider label="Volume" name="volume" low-value="0" high-value="1" class="menu-button"/>
        <ui:Toggle label="Fullscreen" name="fullscreen" class="menu-toggle menu-button"/>
        <ui:Button text="Close" name="Button" class="panel-close menu-button"/>
    </ui:VisualElement>
</ui:UXML>
