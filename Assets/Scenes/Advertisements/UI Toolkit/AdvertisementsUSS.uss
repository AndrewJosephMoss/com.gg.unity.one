:root {
    --font-size: 48px;
    --control-height: 140px;
    --checkbox-size: 64px;
    --control-radius: 24px;
    --control-gap: 20px;
    --control-padding-h: 32px;
    --control-padding-v: 16px;
    --color-text: rgb(240, 240, 240);
    --color-text-disabled: rgb(130, 130, 130);
    --color-surface: rgb(52, 56, 66);
    --color-surface-active: rgb(72, 78, 92);
    --color-surface-disabled: rgb(38, 40, 46);
    --color-accent: rgb(90, 160, 255);
    --color-border: rgb(110, 116, 130);
}

.menu {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.menu-button {
    width: 80%;
    min-width: 300px;
    max-width: 960px;
    min-height: var(--control-height);
    margin: 0 0 var(--control-gap) 0;
    padding: var(--control-padding-v) var(--control-padding-h);
    font-size: var(--font-size);
    color: var(--color-text);
    -unity-text-align: middle-center;
    white-space: normal;
    background-color: var(--color-surface);
    border-width: 2px;
    border-color: var(--color-border);
    border-radius: var(--control-radius);
    transition-property: background-color, scale;
    transition-duration: 0.1s;
}

.menu-button:active {
    background-color: var(--color-surface-active);
    scale: 0.98 0.98;
}

.menu-button:focus {
    border-color: var(--color-accent);
}

.menu-button:disabled {
    color: var(--color-text-disabled);
    background-color: var(--color-surface-disabled);
}

.menu-toggle {
    flex-direction: row;
    align-items: center;
    width: 80%;
    min-width: 300px;
    max-width: 960px;
    min-height: var(--control-height);
    margin: 0 0 var(--control-gap) 0;
    padding: 0 var(--control-padding-h);
}

.menu-toggle > .unity-label {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    min-width: 0;
    margin: 0;
    padding: 0;
    font-size: var(--font-size);
    color: var(--color-text);
    -unity-text-align: middle-left;
    white-space: normal;
}

.menu-toggle > .unity-toggle__input {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: var(--checkbox-size);
    min-width: var(--checkbox-size);
    height: var(--checkbox-size);
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 0 0 0 12px;
    padding: 0;
}

.menu-toggle .unity-toggle__checkmark {
    width: var(--checkbox-size);
    height: var(--checkbox-size);
    flex-shrink: 0;
    margin: 0;
    background-color: var(--color-surface);
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--color-accent);
    border-width: 3px;
    border-color: var(--color-border);
    border-radius: 12px;
}

.menu-toggle .unity-toggle__input:checked > .unity-toggle__checkmark {
    border-color: var(--color-accent);
}

.menu-toggle .unity-toggle__input:focus > .unity-toggle__checkmark {
    border-color: var(--color-accent);
}

.menu-toggle:disabled .unity-toggle__checkmark {
    background-color: var(--color-surface-disabled);
    border-color: var(--color-surface-disabled);
}

.menu-toggle:disabled > .unity-label {
    color: var(--color-text-disabled);
}
